{
	"over_setpoint": {
		"description": "Defines the logic and recorded parameters for over setpoint conditions in standard alarms.",
		"logic": [
			"When value rises above Pickup setpoint (A) and remains ≥ ΔT1 alarm ON",
			"when value falls below Dropout setpoint (B) and remains ≥ ΔT2, alarm OFF."
		],
		"recorded_parameters": {
			"A": "Pickup setpoint value",
			"B": "Dropout setpoint value",
			"dT1": "Pickup time delay period (s)",
			"EV1": "Start of alarm condition",
			"dT2": "Dropout time delay (s)",
			"EV2": "End of alarm condition",
			"dT3": "Alarm duration (s)",
			"Max1": "Maximum value during pickup period",
			"Max2": "Maximum value during alarm period"
		}
	},
	"under_setpoint": {
		"logic": [
			"When value falls below Pickup setpoint (A) and remains ≥ ΔT1, alarm ON",
			"when value rises above Dropout setpoint (B) and remains ≥ ΔT2, alarm OFF."
		],
		"recorded_parameters": {
			"A": "Pickup setpoint value",
			"B": "Dropout setpoint value",
			"dT1": "Pickup time delay period (s)",
			"EV1": "Start of alarm condition",
			"dT2": "Dropout time delay (s)",
			"EV2": "End of alarm condition",
			"dT3": "Alarm duration (s)",
			"Min1": "Minimum value during pickup period",
			"Min2": "Minimum value during alarm period"
		}
	},
